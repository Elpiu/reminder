  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@iconify-json/lucide": "^1.2.156",
    "@nuxt/ui": "^4.12.2",
    "dexie": "^4.4.7",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.19.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/nuxt": "^2.0.1",
    "cross-env": "^10.0.0",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
